# Model used by every agent via Ollama (qwen2.5:3b, gwen2.5:3b, llama3, etc.)
AGENT_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
AGENT_TEMPERATURE=0.1

# Server
# Use 127.0.0.1 for local development, 0.0.0.0 for cloud hosting (Render, Docker, etc.)
HOST=0.0.0.0
PORT=8000
FLASK_DEBUG=0
WAITRESS_THREADS=16

# Limits
MAX_CONCURRENT_RUNS=3
MAX_DELEGATIONS=12
MAX_AGENT_TURNS=16
MAX_TASK_CHARS=20000
# Specialists that run at the same time. Set to 1 if you hit Groq rate limits.
MAX_PARALLEL_TOOLS=4

# DATABASE_PATH=instance/multi_agent.db
